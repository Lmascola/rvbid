# ---------------------------------------------------------------------------
# RVBID — environment template. Copy to `.env` and fill in real values.
# Everything the app reads at build or runtime is listed here.
# ---------------------------------------------------------------------------

# --- Supabase (your own project) -------------------------------------------
# Browser-visible (baked into the build by Vite). Safe to expose.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side copies used during SSR and by server functions/routes.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Service role key — SERVER ONLY, never expose. Required by the deposit
# watcher to credit wallets. Supabase dashboard → Project Settings → API keys.
SUPABASE_SERVICE_ROLE_KEY="SERVICE_ROLE_KEY_HERE"

# --- Application ------------------------------------------------------------
# Marks the deployment as self-hosted (no Lovable platform services).
VITE_SELF_HOSTED="true"
# Public base URL of the site; used in emails and OAuth/reset redirects.
APP_URL="https://rvbidlive.com"

# --- Email: senders ---------------------------------------------------------
# Authentication emails: 6-digit verification codes and password resets.
EMAIL_FROM_AUTH="noreply@rvbidlive.com"
# Notification emails: outbid alerts, KYC decisions, deposit/withdrawal status.
EMAIL_FROM_NOTIFICATIONS="support@rvbidlive.com"
# Friendly display name shown in inboxes.
EMAIL_FROM_NAME="RVBID"

# --- Email: verification gate (server-side only) ---------------------------
# true  → new registrations must confirm a 6-digit email code before the
#         mandatory Identity Verification (KYC) step.
# false → email verification is skipped; users go straight to KYC.
# Default when unset: true. Never exposed to the browser.
EMAIL_VERIFICATION_REQUIRED="true"

# --- Email: SMTP ------------------------------------------------------------
# Auth emails (codes + resets) are sent by Supabase Auth, so these same values
# must also be entered in Supabase → Authentication → SMTP Settings.
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
# "tls" (STARTTLS on 587) or "ssl" (implicit TLS on 465).
SMTP_SECURE="tls"

# --- Scheduled automation ---------------------------------------------------
# Shared secret required by /api/public/close-auctions and
# /api/public/deposit-watch via the `x-cron-secret` header.
CRON_SECRET="generate-a-long-random-string"

# --- Deposit detection ------------------------------------------------------
# Optional: needed only for Ethereum / ERC-20 deposit scanning.
ETHERSCAN_API_KEY=""

# --- Deployment (docker-compose / Caddy) ------------------------------------
# Domain Caddy issues the TLS certificate for.
DOMAIN="rvbidlive.com"
# Email used for Let's Encrypt registration.
ACME_EMAIL="admin@rvbidlive.com"
